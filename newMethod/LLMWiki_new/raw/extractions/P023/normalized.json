      ],
      "stage_output": [
        "pre-trained diffusion model ϕθ"
      ],
      "evidence": [
        {
          "text": "In the pre-training phase, we perform the task of crystal structure reconstruction to model the distribution p(F, L | A) based on the diffusion model from a large amount of unlabeled data.",
          "page": 3,
          "section": "Methodology",
          "inferred": false
        },
        {
          "text": "In the pre-training phase, CrysDiff tries to reconstruct the original crystal structures via a joint denoising diffusion model given the atom compositions only, and thus is self-supervised without annotations of target properties.",
          "page": 2,
          "section": "Introduction",
          "inferred": false
        }
      ]
