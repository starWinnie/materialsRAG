      "stage_type": "model_training",
      "stage_name_raw": "pre-training via crystal structure reconstruction",
      "stage_order": 3,
      "stage_goal": "Learn the latent marginal distribution of crystal structures p(F, L | A) using a joint denoising diffusion model on lattice L and fractional coordinates F given atom composition A",
      "stage_input": [
